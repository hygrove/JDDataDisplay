# ========== Python ==========
.venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.mypy_cache/

# ========== 前端 ==========
node_modules/
frontend/dist/
frontend/tsconfig.tsbuildinfo
# 回归脚本的 esbuild 打包产物（由 npm run verify 生成，可随时重建）
frontend/node_modules/.cache/

# ========== 运行生成的数据（run_batch 重新生成，不入仓） ==========
backend/app/data/
# SQLite 数据库文件（由 run_batch 从 Excel 增量重建，不入库）
*.db

# ========== 业务数据源 ResourceData（后续不入仓库，仅保留 sample_data/ 作样例） ==========
# ResourceData/ 含每日增长的业务 Excel / CSV / SPU 图片，体积大且含业务数据，不进 git；
# 异地 / 本地测试用 sample_data/ 下的少量样例表（git 跟踪），跑前用 scripts/setup_sample.py 复制过去。
ResourceData/

# ========== 助手工作记忆（非项目源码） ==========
.workbuddy/

# ========== 版本控制工具元数据 ==========
# jj（Jujutsu）本地仓库元数据；colocated 模式下 git 会把它当未跟踪文件，必须忽略，勿提交进仓库
.jj/

# ========== 日志 / 临时 / 截图 ==========
*.log
logs/
screenshot_*.png

# ========== 本地工具 / 演示 / 临时探针（非项目源码） ==========
DB.Browser.for.SQLite-v3.13.1-win64/
preview/
# 下划线前缀的临时产物：AI 调试探针、构建退出码、截图、一次性脚本
# （正式脚本一律用无前缀命名，避免与源码混淆；scripts/ 下不适用，
#  因 _install_tasks.ps1 / _setup_daily_refresh.ps1 是被 install_tasks.bat 调用的真实脚本）
/_*
frontend/_*
# scripts/ 下的一次性 .py 调试脚本（.ps1 不忽略：_install_tasks.ps1 /
# _setup_daily_refresh.ps1 是被 .bat 调用的真实脚本）
scripts/_*.py

# ========== 编辑器 / 系统文件 ==========
.vscode/
.idea/
.DS_Store
Thumbs.db

# ========== Excel 锁文件（Excel 打开时产生，形如 ~$xxx.xlsx） ==========
~$*

# ========== 密钥 / 环境配置 ==========
.env

# ========== 设计探索稿（一次性方案对比用，定稿后不入库） ==========
mockups/
