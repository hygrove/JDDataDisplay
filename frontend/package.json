{
  "name": "jd-viz-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "verify": "npm run verify:month && npm run verify:agg",
    "verify:month": "esbuild verify_month_compare.mjs --bundle --platform=node --format=esm --outfile=node_modules/.cache/verify_month.mjs --log-level=warning && node node_modules/.cache/verify_month.mjs",
    "verify:agg": "esbuild verify_agg.mjs --bundle --platform=node --format=esm --outfile=node_modules/.cache/verify_agg.mjs --log-level=warning && node node_modules/.cache/verify_agg.mjs"
  },
  "dependencies": {
    "@tanstack/vue-virtual": "^3.10.8",
    "echarts": "^5.5.1",
    "pinia": "^2.2.4",
    "vue": "^3.5.12",
    "vue-echarts": "^7.0.3",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.1.4",
    "typescript": "~5.6.3",
    "vite": "^5.4.9",
    "vue-tsc": "^2.1.6"
  }
}
